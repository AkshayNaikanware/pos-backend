# ---- App ----
APP_PORT=3000

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=pos
DB_LOGGING=false

# ---- Auth ----
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# ---- Business ----
TAX_RATE_PERCENT=5
CURRENCY=INR

# ---- Redis (optional: leave empty to disable caching) ----
REDIS_URL=redis://localhost:6379

# ---- Tests ----
# Tests run against a separate database that is created and reset automatically.
TEST_DB_NAME=pos_test
